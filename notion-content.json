_preview_url":"attachment:2a9d30ad-e974-4285-b60f-305c4854c152:SocialMediaPreviewImage.png"},"content":["3e72ebc0-17ad-80ec-b8b7-f06f95caa4da","3b54d2ea-0d5e-4ab5-b33c-ff12de807517","3e72ebc0-17ad-80b8-9aa2-c9d79eb302b7"],"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3e82ebc0-17ad-8055-baf3-de091e47891f":{"value":{"id":"3e82ebc0-17ad-8055-baf3-de091e47891f","type":"text","properties":{"title":[["1.Notion DB에 새 항목 생성:",[["b"]]],["데이터베이스 관리 페이지 접근.\nXCONDA_NEWs DB에서 + 새 페이지 버튼을 눌러 새 레코드를 만듭니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3e82ebc0-17ad-8062-a433-d9f2f6791856":{"value":{"id":"3e82ebc0-17ad-8062-a433-d9f2f6791856","type":"text","properties":{"title":[["2.기본 필드 및 메타데이터 입력:",[["b"]]],["Title, Type, Date 설정.\nTitle, Type, Date 항목을 필수로 작성하고, 필요시 Summary 및 Category를 입력합니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3e82ebc0-17ad-807d-8ecd-fc0d81b1257d":{"value":{"id":"3e82ebc0-17ad-807d-8ecd-fc0d81b1257d","type":"text","properties":{"title":[["3.본문 콘텐츠 구성:",[["b"]]],["Notion 블록 활용.\n페이지 본문에 헤딩(H1~H3), 토글, 리스트, 코드 블록 등을 활용하여 상세 안내 문서를 작성합니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3e82ebc0-17ad-8002-8dbd-fbac50361447":{"value":{"id":"3e82ebc0-17ad-8002-8dbd-fbac50361447","type":"text","properties":{"title":[["4.Published 체크 (발행):",[["b"]]],["10분 자동 배포 주기.\n작성이 완료되면 Published 체크박스를 활성화합니다. 배포 파이프라인이 동작하여 10분 이내에 웹사이트에 자동 반영됩니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3e82ebc0-17ad-809a-8b8e-dddcdd6dfd87":{"value":{"id":"3e82ebc0-17ad-809a-8b8e-dddcdd6dfd87","type":"text","properties":{"title":[["5.수동 배포 (긴급 발행 시):",[["b"]]],["GitHub Actions Manual Run.\n즉시 반영이 필요한 경우 GitHub Repository의 Actions 탭으로 이동하여 Run workflow를 수동 실행합니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}}}}}
