95"}},"3f42ebc0-17ad-8093-919c-d6a134bf14c3":{"value":{"id":"3f42ebc0-17ad-8093-919c-d6a134bf14c3","type":"text","properties":{"title":[["2024년 5월 OpenAI가 GPT-4o를 선보인 이후, AI는 이미지와 오디오까지 실시간으로 다루며 '눈과 귀를 가진 존재'로 진화했습니다. 이에 따라 AI 영상 제작도 빠르게 확산되고 있죠."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-807e-a0d4-dbba45a0a082":{"value":{"id":"3f42ebc0-17ad-807e-a0d4-dbba45a0a082","type":"text","properties":{"title":[["하지만 AI로 영상을 만들다 보면 꼭 한 번쯤 마주치는 문제가 있습니다. 바로 \"화면의 앞뒤 맥락이 연결되지 않는 현상\"입니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-8081-9564-d15f798f8620":{"value":{"id":"3f42ebc0-17ad-8081-9564-d15f798f8620","type":"sub_sub_header","properties":{"title":[["'맥락 붕괴(Context Collapse)'란?"]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-8025-b38d-ccf588c1b764":{"value":{"id":"3f42ebc0-17ad-8025-b38d-ccf588c1b764","type":"text","properties":{"title":[["로맨스 드라마에서 여자 주인공이 남자 주인공 바지에 실수로 커피를 쏟았다고 가정해 봅시다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-8040-8b79-f495df0b44b8":{"value":{"id":"3f42ebc0-17ad-8040-8b79-f495df0b44b8","type":"text","properties":{"title":[["현실이라면 바지를 갈아입지 않는 한 커피 자국은 남아 있어야 합니다. 하지만 "],["다음 컷에서 아무런 조치도 없이 자국이 감쪽같이 사라진다면 어떨까요?",[["b"]]]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-807b-bbd2-c31bb9f233ff":{"value":{"id":"3f42ebc0-17ad-807b-bbd2-c31bb9f233ff","type":"text","properties":{"title":[["작품의 개연성은 무너지고, 제작진은 수동 보정 작업에 막대한 시간과 비용을 쏟아붓게 됩니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-809e-9017-c4cfbb1116b8":{"value":{"id":"3f42ebc0-17ad-809e-9017-c4cfbb1116b8","type":"text","properties":{"title":[["이처럼 AI가 앞뒤 맥락을 기억하지 못하고 컷마다 배경이나 소품을 제멋대로 바꿔버리는 현상을 "],["'맥락 붕괴(Context Collapse)'",[["b"]]],[", 일명 '9컷의 저주'라고 부릅니다."]]},"space_id":"19e2ebc0-17ad-8144-8210-0003d7523b95"}},"3f42ebc0-17ad-802b-a46f-e8ea5363504a":{"value":{"id":"3f42ebc0-17ad-802b-a46f-e8ea5363504a","type":"sub_sub_header","properties":{"title":[[